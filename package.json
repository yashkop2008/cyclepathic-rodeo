{
  "name": "cyclepathic-rodeo",
  "version": "0.1.0",
  "description": "Cyclepathic Rodeo: tilt-the-world unicycle party racer. Phones are controllers, one big screen hosts the race.",
  "private": true,
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "https": "node server/index.js --https",
    "icons": "node scripts/make-icons.js",
    "tunnel": "cloudflared tunnel --url http://localhost:3000"
  },
  "dependencies": {
    "express": "^5.3.0",
    "phaser": "^3.90.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "socket.io": "^4.8.4"
  }
}
